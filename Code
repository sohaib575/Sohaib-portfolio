/* ════════════════════════════════════════════════════════════
   9. LIGHTBOX
   ════════════════════════════════════════════════════════════ */
let lbIndex = 0;

function initLightbox() {
  const overlay  = document.getElementById("lightbox");
  const img      = document.getElementById("lightboxImg");
  const caption  = document.getElementById("lightboxCaption");
  const btnClose = document.getElementById("lightboxClose");
  const btnPrev  = document.getElementById("lightboxPrev");
  const btnNext  = document.getElementById("lightboxNext");

  btnClose.addEventListener("click", closeLightbox);
  overlay.addEventListener("click", e => { if (e.target === overlay) closeLightbox(); });

  btnPrev.addEventListener("click", () => {
    lbIndex = (lbIndex - 1 + GALLERY_ITEMS.length) % GALLERY_ITEMS.length;
    showLbImage();
  });
  btnNext.addEventListener("click", () => {
    lbIndex = (lbIndex + 1) % GALLERY_ITEMS.length;
    showLbImage();
  });

  // Keyboard navigation
  document.addEventListener("keydown", e => {
    if (overlay.style.display === "none" || !overlay.classList.contains("active")) return;
    if (e.key === "ArrowLeft")  btnPrev.click();
    if (e.key === "ArrowRight") btnNext.click();
    if (e.key === "Escape")     closeLightbox();
  });

  function showLbImage() {
    const item = GALLERY_ITEMS[lbIndex];
    img.src         = item.src;
    img.alt         = item.alt;
    caption.textContent = `${item.caption}  (${lbIndex + 1} / ${GALLERY_ITEMS.length})`;
  }

  // Expose open function
  window._showLbImage = showLbImage;
}

function openLightbox(idx) {
  lbIndex = idx;
  const overlay = document.getElementById("lightbox");
  overlay.style.display = "flex";
  overlay.classList.add("active");
  if (window._showLbImage) window._showLbImage();
  document.body.style.overflow = "hidden";
}

function closeLightbox() {
  const overlay = document.getElementById("lightbox");
  overlay.style.display = "none";
  overlay.classList.remove("active");
  document.body.style.overflow = "";
}


