/**
 * PORTFOLIO — script.js
 * Modules: Loader · Lucide icons · Theme · Navbar · Typing animation
 *          Scroll reveal · Stat counters · Academic table · Progress bars
 *          Gallery · Lightbox · CV modal · Contact form · Scroll-to-top
 */

/* ════════════════════════════════════════════════════════════
   0. INIT & LOADING SCREEN
   ════════════════════════════════════════════════════════════ */
window.addEventListener("DOMContentLoaded", () => {

  // ── Lucide icons (safe — won't crash if CDN fails) ──
  try {
    try { if (typeof lucide !== "undefined") lucide.createIcons(); } catch(e) {}
  } catch (e) { console.warn("Lucide icons failed to load:", e); }

  // ── Hide loader & start everything ──
  // Uses a short timeout (600ms) so it works even offline/file://
  function bootApp() {
    const loader = document.getElementById("loader");
    if (loader) {
      loader.classList.add("hidden");
      // Remove from DOM after fade-out transition
      setTimeout(() => loader.remove(), 600);
    }
    startTypingAnimation();
    initScrollReveal();
    initStatCounters();
    initProgressBars();
  }

  // Attempt to boot after 600 ms regardless of network state
  setTimeout(bootApp, 600);

  // Run all module initialisers
  initTheme();
  initNavbar();
  initAcademicTable();
  initGallery();
  initLightbox();
  initCVModal();
  initContactForm();
  initScrollTop();
});


/* ════════════════════════════════════════════════════════════
   1. THEME SWITCHER  (persists via localStorage)
   ════════════════════════════════════════════════════════════ */
function initTheme() {
  const html      = document.documentElement;
  const toggle    = document.getElementById("themeToggle");
  const iconSun   = document.getElementById("iconSun");
  const iconMoon  = document.getElementById("iconMoon");

  // Load saved preference or default to dark
  const saved = localStorage.getItem("portfolio-theme") || "dark";
  applyTheme(saved);

  toggle.addEventListener("click", () => {
    const next = html.dataset.theme === "dark" ? "light" : "dark";
    applyTheme(next);
    localStorage.setItem("portfolio-theme", next);
  });

  function applyTheme(theme) {
    html.dataset.theme = theme;
    if (theme === "dark") {
      iconSun.style.display  = "";
      iconMoon.style.display = "none";
    } else {
      iconSun.style.display  = "none";
      iconMoon.style.display = "";
    }
    // Re-render icons after display toggle
    try { if (typeof lucide !== "undefined") lucide.createIcons(); } catch(e) {}
  }
}


/* ════════════════════════════════════════════════════════════
   2. NAVBAR — sticky scroll shadow, hamburger, active link
   ════════════════════════════════════════════════════════════ */
function initNavbar() {
  const navbar    = document.getElementById("navbar");
  const hamburger = document.getElementById("hamburger");
  const navLinks  = document.getElementById("navLinks");
  const menuIcon  = document.getElementById("menuIcon");
  const closeIcon = document.getElementById("closeIcon");
  const links     = document.querySelectorAll(".nav-link");

  // Sticky shadow
  window.addEventListener("scroll", () => {
    navbar.classList.toggle("scrolled", window.scrollY > 24);
    updateActiveLink();
  }, { passive: true });

  // Hamburger toggle
  hamburger.addEventListener("click", () => {
    const open = navLinks.classList.toggle("open");
    menuIcon.style.display  = open ? "none" : "";
    closeIcon.style.display = open ? "" : "none";
    try { if (typeof lucide !== "undefined") lucide.createIcons(); } catch(e) {}
  });

  // Close menu on link click
  links.forEach(link => {
    link.addEventListener("click", () => {
      navLinks.classList.remove("open");
      menuIcon.style.display  = "";
      closeIcon.style.display = "none";
      try { if (typeof lucide !== "undefined") lucide.createIcons(); } catch(e) {}
    });
  });

  // Active section highlighting
  function updateActiveLink() {
    const sections = document.querySelectorAll("section[id]");
    let current = "";
    sections.forEach(s => {
      if (window.scrollY >= s.offsetTop - 120) current = s.id;
    });
    links.forEach(l => {
      l.classList.toggle("active", l.getAttribute("href") === `#${current}`);
    });
  }
  updateActiveLink();
}


/* ════════════════════════════════════════════════════════════
   3. TYPING ANIMATION
   ════════════════════════════════════════════════════════════ */
function startTypingAnimation() {
  const el    = document.getElementById("typedText");
  if (!el) return;

  const names = ["Muhammad Sohaib"];
  let   nameIdx  = 0;
  let   charIdx  = 0;
  let   deleting = false;
  const SPEED_TYPE = 80;
  const SPEED_DEL  = 45;
  const PAUSE_END  = 1800;
  const PAUSE_START= 350;

  function tick() {
    const current = names[nameIdx];

    if (!deleting) {
      // Type forward
      el.textContent = current.slice(0, charIdx + 1);
      charIdx++;
      if (charIdx === current.length) {
        // Pause then start deleting (unless it's the last "Alex Morgan" — keep it)
        if (nameIdx === names.length - 1) return; // stop after final name
        deleting = true;
        setTimeout(tick, PAUSE_END);
        return;
      }
    } else {
      // Delete backward
      el.textContent = current.slice(0, charIdx - 1);
      charIdx--;
      if (charIdx === 0) {
        deleting = false;
        nameIdx  = (nameIdx + 1) % names.length;
        setTimeout(tick, PAUSE_START);
        return;
      }
    }

    setTimeout(tick, deleting ? SPEED_DEL : SPEED_TYPE);
  }

  tick();
}


/* ════════════════════════════════════════════════════════════
   4. SCROLL REVEAL
   ════════════════════════════════════════════════════════════ */
function initScrollReveal() {
  const items = document.querySelectorAll(".reveal");
  if (!items.length) return;

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        // Stagger cards inside a grid
        const delay = entry.target.dataset.index
          ? parseInt(entry.target.dataset.index) * 80
          : 0;
        setTimeout(() => {
          entry.target.classList.add("visible");
        }, delay);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  items.forEach(item => observer.observe(item));
}


/* ════════════════════════════════════════════════════════════
   5. STAT COUNTERS
   ════════════════════════════════════════════════════════════ */
function initStatCounters() {
  const counters = document.querySelectorAll(".stat-number[data-target]");
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el     = entry.target;
      const target = parseInt(el.dataset.target);
      const duration = 1200;
      const start    = performance.now();

      function step(now) {
        const progress = Math.min((now - start) / duration, 1);
        const eased    = 1 - Math.pow(1 - progress, 3); // ease-out-cubic
        el.textContent = Math.round(eased * target);
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
      observer.unobserve(el);
    });
  }, { threshold: 0.5 });

  counters.forEach(c => observer.observe(c));
}


/* ════════════════════════════════════════════════════════════
   6. PROGRESS BARS
   ════════════════════════════════════════════════════════════ */
function initProgressBars() {
  const bars = document.querySelectorAll(".progress-fill[data-width]");
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const bar = entry.target;
      // Delay slightly so user notices animation
      setTimeout(() => {
        bar.style.width = bar.dataset.width + "%";
      }, 300);
      observer.unobserve(bar);
    });
  }, { threshold: 0.3 });

  bars.forEach(b => observer.observe(b));
}


/* ════════════════════════════════════════════════════════════
   7. ACADEMIC TABLE — data, search, sort
   ════════════════════════════════════════════════════════════ */
const ACADEMIC_DATA = [
  { degree: "BS Computer Science",      institute: "University of Engineering and Technology Peshawar, Abbottabad Campus", year: 2025, grade: "3.77 GPA", status: "ongoing"  },
  { degree: "Intermediate (Computer Science)",  institute: "Government Postgraduate College Haripur ",          year: 2024, grade: "74%",   status: "done"    },
  { degree: "Matriculation (Science)",  institute: "Government High School No 3 Haripur", year: 2022, grade: "81.18%",   status: "done"    },
  { degree: "Diploma in Information Technology",      institute: "Government College of Management Sciences Haripur",              year: 2024, grade: "Distinction", status: "done" },

];

let sortState = { key: "year", dir: "desc" };
let searchTerm = "";

function initAcademicTable() {
  renderTable();

  // Search
  const searchInput = document.getElementById("tableSearch");
  searchInput.addEventListener("input", () => {
    searchTerm = searchInput.value.toLowerCase();
    renderTable();
  });

  // Sort buttons
  document.querySelectorAll(".sort-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.sort;
      if (sortState.key === key) {
        sortState.dir = sortState.dir === "asc" ? "desc" : "asc";
      } else {
        sortState.key = key;
        sortState.dir = "asc";
      }
      document.querySelectorAll(".sort-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderTable();
    });
  });
}

function renderTable() {
  const tbody     = document.getElementById("academicBody");
  const noResults = document.getElementById("noResults");

  // Filter
  let data = ACADEMIC_DATA.filter(row => {
    const haystack = [row.degree, row.institute, row.year, row.grade, row.status]
      .join(" ").toLowerCase();
    return haystack.includes(searchTerm);
  });

  // Sort
  data.sort((a, b) => {
    let av = a[sortState.key], bv = b[sortState.key];
    if (typeof av === "string") av = av.toLowerCase();
    if (typeof bv === "string") bv = bv.toLowerCase();
    if (av < bv) return sortState.dir === "asc" ? -1 : 1;
    if (av > bv) return sortState.dir === "asc" ?  1 : -1;
    return 0;
  });

  if (data.length === 0) {
    tbody.innerHTML = "";
    noResults.style.display = "block";
    return;
  }
  noResults.style.display = "none";

  tbody.innerHTML = data.map((row, i) => `
    <tr>
      <td>${String(i + 1).padStart(2, "0")}</td>
      <td>${escapeHtml(row.degree)}</td>
      <td>${escapeHtml(row.institute)}</td>
      <td>${row.year}</td>
      <td>${escapeHtml(row.grade)}</td>
      <td>
        <span class="badge ${row.status === "done" ? "badge-done" : "badge-ongoing"}">
          ${row.status === "done" ? "Completed" : "In Progress"}
        </span>
      </td>
    </tr>
  `).join("");
}

function escapeHtml(str) {
  return String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

