/* ============================================================
   PORTFOLIO — style.css
   Theme: Dark editorial/tech with light mode variant
   Fonts: Playfair Display (display) + JetBrains Mono (body)
   ============================================================ */

/* ── CSS Variables ─────────────────────────────────────────── */
:root {
  /* Dark theme (default) */
  --bg-primary:    #080c14;
  --bg-secondary:  #0d1220;
  --bg-card:       #111827;
  --bg-card-hover: #161f30;
  --border:        rgba(99, 179, 237, 0.12);
  --border-hover:  rgba(99, 179, 237, 0.35);

  --text-primary:  #e8edf5;
  --text-secondary:#8b9ab8;
  --text-muted:    #4b5a75;

  --accent:        #38bdf8;   /* electric cyan */
  --accent-glow:   rgba(56,189,248,0.25);
  --accent2:       #f59e0b;   /* warm amber */
  --accent2-glow:  rgba(245,158,11,0.20);

  --gradient-hero: radial-gradient(ellipse 80% 60% at 60% 40%,
                    rgba(56,189,248,0.15) 0%,
                    rgba(245,158,11,0.07) 50%,
                    transparent 100%);

  --shadow-card:   0 4px 24px rgba(0,0,0,0.45), 0 0 0 1px var(--border);
  --shadow-glow:   0 0 32px var(--accent-glow);

  --radius-sm:     8px;
  --radius-md:     14px;
  --radius-lg:     22px;

  --transition:    0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --font-display:  'Playfair Display', Georgia, serif;
  --font-body:     'JetBrains Mono', 'Courier New', monospace;
}

[data-theme="light"] {
  --bg-primary:    #f0f4fb;
  --bg-secondary:  #e4eaf5;
  --bg-card:       #ffffff;
  --bg-card-hover: #f8faff;
  --border:        rgba(56,100,200,0.15);
  --border-hover:  rgba(56,100,200,0.40);

  --text-primary:  #0d1a2e;
  --text-secondary:#3a4f72;
  --text-muted:    #7a8caa;

  --accent:        #0284c7;
  --accent-glow:   rgba(2,132,199,0.20);
  --accent2:       #d97706;
  --accent2-glow:  rgba(217,119,6,0.15);

  --gradient-hero: radial-gradient(ellipse 80% 60% at 60% 40%,
                    rgba(2,132,199,0.10) 0%,
                    rgba(217,119,6,0.06) 50%,
                    transparent 100%);

  --shadow-card:   0 4px 20px rgba(0,40,120,0.10), 0 0 0 1px var(--border);
  --shadow-glow:   0 0 24px var(--accent-glow);
}

/* ── Reset & Base ───────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-body);
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.7;
  transition: background var(--transition), color var(--transition);
  overflow-x: hidden;
}

img { max-width: 100%; display: block; }
a   { text-decoration: none; color: inherit; }
button { cursor: pointer; border: none; background: none; font-family: inherit; }
ul { list-style: none; }

::selection { background: var(--accent); color: #000; }

/* ── Scrollbar ──────────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg-primary); }
::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 99px; }

/* ── Loading Screen ─────────────────────────────────────────── */
#loader {
  position: fixed;
  inset: 0;
  background: var(--bg-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  transition: opacity 0.5s ease, visibility 0.5s ease;
}
#loader.hidden { opacity: 0; visibility: hidden; }

.loader-inner { display: flex; flex-direction: column; align-items: center; gap: 16px; }

.loader-ring {
  width: 52px;
  height: 52px;
  border: 3px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.loader-text {
  font-size: 0.8rem;
  color: var(--text-secondary);
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.loader-dots { animation: ellipsis 1.4s infinite; }

@keyframes spin { to { transform: rotate(360deg); } }
@keyframes ellipsis {
  0%   { content: '.'; }
  33%  { content: '..'; }
  66%  { content: '...'; }
}

/* ── Scroll-to-top ──────────────────────────────────────────── */
#scrollTop {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 44px;
  height: 44px;
  background: var(--accent);
  color: #000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(16px);
  transition: opacity var(--transition), transform var(--transition);
  z-index: 500;
  box-shadow: var(--shadow-glow);
}
#scrollTop.visible { opacity: 1; transform: translateY(0); }
#scrollTop:hover { transform: translateY(-3px); }

/* ── Navbar ─────────────────────────────────────────────────── */
#navbar {
  position: sticky;
  top: 0;
  z-index: 400;
  background: rgba(8, 12, 20, 0.72);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
  transition: background var(--transition), box-shadow var(--transition);
}
[data-theme="light"] #navbar {
  background: rgba(240, 244, 251, 0.80);
}
#navbar.scrolled {
  box-shadow: 0 4px 32px rgba(0,0,0,0.30);
}

.nav-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  height: 64px;
  display: flex;
  align-items: center;
  gap: 24px;
}

.nav-logo {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 1.4rem;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  flex-shrink: 0;
}
.accent { color: var(--accent); }

.nav-links {
  display: flex;
  gap: 4px;
  flex: 1;
  justify-content: center;
  align-items: center;
}

.nav-link {
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-secondary);
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  line-height: 1;
  transition: color var(--transition), background var(--transition);
}
.nav-link:hover, .nav-link.active {
  color: var(--accent);
  background: var(--accent-glow);
}

.nav-actions { display: flex; gap: 8px; align-items: center; }

.icon-btn {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  transition: color var(--transition), background var(--transition);
}
.icon-btn:hover { color: var(--accent); background: var(--accent-glow); }

.hamburger-btn { display: none; }

/* ── Container & Section Base ───────────────────────────────── */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

.section {
  padding: 96px 0;
}
.section-alt { background: var(--bg-secondary); }

.section-label {
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-label span {
  font-family: var(--font-display);
  font-size: 1rem;
  opacity: 0.4;
  color: var(--text-primary);
}

.section-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 900;
  color: var(--text-primary);
  margin-bottom: 48px;
  line-height: 1.15;
}

/* ── Reveal animation ───────────────────────────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── Hero Section ───────────────────────────────────────────── */
#hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 0px 24px;
}

.hero-mesh {
  position: absolute;
  inset: 0;
  background: var(--gradient-hero);
  pointer-events: none;
}

.hero-grid-overlay {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--border) 1px, transparent 1px),
    linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 64px 64px;
  opacity: 0.4;
  pointer-events: none;
}

.hero-container {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 64px;
  justify-content: space-between;
}

.hero-text { flex: 1; max-width: 600px; }

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent2);
  margin-bottom: 20px;
  background: var(--accent2-glow);
  padding: 6px 14px;
  border-radius: 99px;
  border: 1px solid rgba(245,158,11,0.25);
}
.dot {
  width: 7px;
  height: 7px;
  background: var(--accent2);
  border-radius: 50%;
  animation: pulse 1.8s infinite;
}
@keyframes pulse {
  0%,100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.5; transform: scale(1.5); }
}

.hero-name {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 6vw, 4.4rem);
  font-weight: 900;
  line-height: 1.08;
  color: var(--text-primary);
  margin-bottom: 12px;
  min-height: 1.2em;
}

.cursor {
  color: var(--accent);
  animation: blink 0.8s step-end infinite;
}
@keyframes blink { 0%,100% { opacity:1; } 50% { opacity:0; } }

.hero-title {
  font-size: 1rem;
  color: var(--accent);
  letter-spacing: 0.06em;
  margin-bottom: 8px;
}

.hero-reg {
  font-size: 0.78rem;
  color: var(--text-muted);
  margin-bottom: 20px;
}

.hero-bio {
  font-size: 0.92rem;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-bottom: 32px;
  max-width: 480px;
}

.hero-cta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 32px;
}

/* ── Buttons ────────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  border-radius: var(--radius-sm);
  font-size: 0.82rem;
  font-family: var(--font-body);
  font-weight: 500;
  letter-spacing: 0.06em;
  transition: all var(--transition);
}
.btn-primary {
  background: var(--accent);
  color: #000;
  box-shadow: 0 0 20px var(--accent-glow);
}
.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 32px var(--accent-glow);
}
.btn-outline {
  border: 1px solid var(--accent);
  color: var(--accent);
}
.btn-outline:hover {
  background: var(--accent-glow);
  transform: translateY(-2px);
}
.btn-ghost {
  color: var(--text-secondary);
  border: 1px solid var(--border);
}
.btn-ghost:hover {
  border-color: var(--border-hover);
  color: var(--text-primary);
  transform: translateY(-2px);
}
.full-width { width: 100%; justify-content: center; }

.btn-sm {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: var(--radius-sm);
  font-size: 0.74rem;
  font-family: var(--font-body);
  border: 1px solid var(--border);
  color: var(--text-secondary);
  transition: all var(--transition);
}
.btn-sm:hover { border-color: var(--border-hover); color: var(--text-primary); }
.btn-sm svg { width: 14px; height: 14px; }
.accent-btn { border-color: var(--accent); color: var(--accent); }
.accent-btn:hover { background: var(--accent-glow); }

/* ── Social Icons ───────────────────────────────────────────── */
.social-links { display: flex; gap: 12px; }
.social-icon {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  transition: all var(--transition);
}
.social-icon:hover {
  color: var(--accent);
  border-color: var(--accent);
  background: var(--accent-glow);
  transform: translateY(-3px);
}

/* ── Hero Image ─────────────────────────────────────────────── */
.hero-image-wrap {
  position: relative;
  flex-shrink: 0;
  width: 300px;
  height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-image-ring {
  position: absolute;
  inset: -20px;
  border: 2px solid var(--accent);
  border-radius: 50%;
  opacity: 0.3;
  animation: ringRotate 8s linear infinite;
}
.ring2 {
  inset: -36px;
  border-style: dashed;
  opacity: 0.15;
  animation-direction: reverse;
  animation-duration: 14s;
}
@keyframes ringRotate { to { transform: rotate(360deg); } }

.hero-img {
  width: 260px;
  height: 260px;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid var(--accent);
  box-shadow: 0 0 48px var(--accent-glow);
  animation: float 5s ease-in-out infinite;
}
@keyframes float {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-12px); }
}

.hero-badge {
  position: absolute;
  bottom: 10px;
  right: -10px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 99px;
  padding: 8px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  color: var(--accent);
  box-shadow: var(--shadow-card);
}

/* ── Scroll indicator ───────────────────────────────────────── */
.scroll-indicator {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.scroll-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, var(--accent), transparent);
  animation: scrollAnim 1.8s ease-in-out infinite;
}
@keyframes scrollAnim {
  0%   { opacity: 1; transform: scaleY(1); transform-origin: top; }
  100% { opacity: 0; transform: scaleY(0); transform-origin: bottom; }
}

/* ── About Section ──────────────────────────────────────────── */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}

.about-text p {
  color: var(--text-secondary);
  margin-bottom: 20px;
  font-size: 0.9rem;
}
.about-text strong { color: var(--text-primary); }

.skills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}
.skill-tag {
  font-size: 0.74rem;
  padding: 6px 14px;
  border: 1px solid var(--border);
  border-radius: 99px;
  color: var(--text-secondary);
  transition: all var(--transition);
}
.skill-tag:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-glow);
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 28px;
  text-align: center;
  transition: all var(--transition);
}
.stat-card:hover {
  border-color: var(--accent);
  box-shadow: var(--shadow-glow);
  transform: translateY(-4px);
}
.stat-number {
  display: block;
  font-family: var(--font-display);
  font-size: 2.8rem;
  font-weight: 900;
  color: var(--accent);
  line-height: 1;
  margin-bottom: 8px;
}
.stat-label {
  font-size: 0.72rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  line-height: 1.4;
}

/* ── Academic Table ─────────────────────────────────────────── */
.table-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.search-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 10px 16px;
  flex: 1;
  max-width: 360px;
  transition: border-color var(--transition);
}
.search-wrap:focus-within { border-color: var(--accent); }
.search-wrap i { color: var(--text-muted); flex-shrink: 0; }
.search-wrap input {
  background: none;
  border: none;
  outline: none;
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: 0.85rem;
  width: 100%;
}
.search-wrap input::placeholder { color: var(--text-muted); }

.sort-btns { display: flex; gap: 8px; flex-wrap: wrap; }
.sort-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 0.74rem;
  font-family: var(--font-body);
  color: var(--text-secondary);
  transition: all var(--transition);
}
.sort-btn:hover, .sort-btn.active {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-glow);
}

.table-wrap {
  overflow-x: auto;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-card);
}

#academicTable {
  width: 100%;
  border-collapse: collapse;
}
#academicTable thead {
  background: var(--bg-card);
  border-bottom: 1px solid var(--border);
}
#academicTable th {
  padding: 14px 20px;
  text-align: left;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
  font-weight: 500;
}
#academicTable td {
  padding: 16px 20px;
  font-size: 0.85rem;
  color: var(--text-secondary);
  border-bottom: 1px solid var(--border);
}
#academicTable tbody tr {
  background: var(--bg-secondary);
  transition: background var(--transition), transform var(--transition);
}
#academicTable tbody tr:last-child td { border-bottom: none; }
#academicTable tbody tr:hover {
  background: var(--bg-card-hover);
}
#academicTable td:nth-child(1) {
  color: var(--text-muted);
  font-size: 0.75rem;
}
#academicTable td:nth-child(2) { color: var(--text-primary); font-weight: 500; }
#academicTable td:nth-child(5) { color: var(--accent); font-weight: 600; }

.badge {
  display: inline-block;
  padding: 3px 12px;
  border-radius: 99px;
  font-size: 0.70rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.badge-done   { background: rgba(52,211,153,0.15); color: #34d399; }
.badge-ongoing{ background: rgba(251,191,36,0.15);  color: #fbbf24; }

.no-results {
  text-align: center;
  padding: 40px;
  color: var(--text-muted);
  font-size: 0.88rem;
}

/* ── Project Cards ──────────────────────────────────────────── */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 24px;
}

.project-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 28px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: all var(--transition);
  box-shadow: var(--shadow-card);
}
.project-card:hover {
  border-color: var(--accent);
  transform: translateY(-6px);
  box-shadow: var(--shadow-glow), var(--shadow-card);
}

.project-icon {
  width: 48px;
  height: 48px;
  background: var(--accent-glow);
  border: 1px solid rgba(56,189,248,0.30);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
}

.project-card h3 {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text-primary);
}
.project-card p {
  font-size: 0.83rem;
  color: var(--text-secondary);
  line-height: 1.7;
  flex: 1;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.project-tags span {
  font-size: 0.70rem;
  padding: 3px 10px;
  border-radius: 99px;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  color: var(--text-muted);
}

.progress-block { display: flex; flex-direction: column; gap: 6px; }
.progress-header {
  display: flex;
  justify-content: space-between;
  font-size: 0.72rem;
  color: var(--text-muted);
}
.progress-pct { color: var(--accent); }
.progress-bar {
  height: 5px;
  background: var(--bg-secondary);
  border-radius: 99px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
  border-radius: 99px;
  width: 0;
  transition: width 1.2s cubic-bezier(0.4,0,0.2,1);
}

.project-links { display: flex; gap: 8px; flex-wrap: wrap; }

/* Project screenshot thumbnail */
.project-thumb {
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  overflow: hidden;
  background: var(--bg-secondary);
}
.project-thumb img {
  display: block;
  width: 100%;
  height: auto;
  transition: transform 0.5s ease;
}
.project-card:hover .project-thumb img { transform: scale(1.04); }

/* ── Gallery ────────────────────────────────────────────────── */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
}

.gallery-item {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  cursor: pointer;
  aspect-ratio: 4/3;
  background: var(--bg-card);
}
.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.gallery-item:hover img { transform: scale(1.08); }
.gallery-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);
  opacity: 0;
  transition: opacity var(--transition);
  display: flex;
  align-items: flex-end;
  padding: 16px;
}
.gallery-item:hover .gallery-overlay { opacity: 1; }
.gallery-caption {
  font-size: 0.80rem;
  color: #fff;
}

/* Match the dark navy background of your portfolio */
#certifications {
  background-color: #0d1117;
  padding: 60px 20px;
}

.cert-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: flex-start;
}

.section-title {
  color: #ffffff;
  font-size: 2rem;
  text-align: center;
  margin-bottom: 40px;
}

.section-title::after {
  content: '';
  display: block;
  width: 60px;
  height: 4px;
  background-color: #38bdf8; /* cyan/blue like your portfolio */
  margin: 10px auto 0;
  border-radius: 2px;
}

.cert-card {
  background: #161b22;
  border: 1px solid #30363d;
  border-radius: 12px;
  padding: 25px;
  flex: 1 1 300px;
  max-width: 340px;
  display: flex;
  gap: 15px;
  align-items: flex-start;
  box-shadow: 0 4px 15px rgba(0,0,0,0.3);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.cert-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(56, 189, 248, 0.15);
  border-color: #38bdf8; /* cyan glow on hover */
}

.cert-info h3 {
  color: #ffffff;
  margin: 0 0 8px;
  font-size: 1.1rem;
}

.cert-issuer {
  color: #8b949e;
  font-size: 0.85rem;
  margin: 4px 0;
}

.cert-date {
  color: #8b949e;
  font-size: 0.85rem;
  margin: 4px 0;
}

.cert-id {
  color: #6e7681;
  font-size: 0.8rem;
  margin: 4px 0;
}

.verify-btn {
  display: inline-block;
  margin-top: 12px;
  padding: 8px 16px;
  background-color: transparent;
  color: #38bdf8;
  border: 1px solid #38bdf8;
  border-radius: 6px;
  text-decoration: none;
  font-size: 0.85rem;
  transition: all 0.3s ease;
}

.verify-btn:hover {
  background-color: #38bdf8;
  color: #0d1117;
}

/* ── Contact ────────────────────────────────────────────────── */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 64px;
  align-items: start;
}

.contact-intro {
  color: var(--text-secondary);
  font-size: 0.92rem;
  line-height: 1.8;
  margin-bottom: 32px;
}

.contact-detail {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-bottom: 20px;
}
.contact-detail i { color: var(--accent); flex-shrink: 0; }

.contact-form { display: flex; flex-direction: column; gap: 20px; }

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 7px;
}
.form-group label {
  font-size: 0.74rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.form-group input,
.form-group textarea {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  font-size: 0.87rem;
  font-family: var(--font-body);
  color: var(--text-primary);
  outline: none;
  transition: border-color var(--transition);
  resize: vertical;
}
.form-group input:focus,
.form-group textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-glow);
}
.form-group input::placeholder,
.form-group textarea::placeholder { color: var(--text-muted); }

.form-error {
  font-size: 0.72rem;
  color: #f87171;
  min-height: 1em;
}

.form-success {
  display: flex;
  align-items: center;
